# AICTE FDR Management Portal - Environment Configuration

# SQLite database file for local development
DATABASE_URL="file:./dev.db"

# WARNING: CRITICAL SECURITY CONFIGURATION
# In production, replace NEXTAUTH_SECRET with a cryptographically secure random 32+ character string.
# Example: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# WARNING: CRITICAL AES-256-GCM DATA ENCRYPTION KEY
# The encryption key used to encrypt sensitive deposit fields and files at rest.
# Must be kept strictly confidential. Do NOT commit the production key to git.
# Format: 64 hexadecimal characters (length: 64 hex characters, generated with: openssl rand -hex 32).
# In src/lib/encryption.ts, the secret string is parsed and hashed via SHA-256 (crypto.createHash('sha256').update(secret).digest()) to derive the 32-byte (256-bit) AES-256-GCM key.
ENCRYPTION_KEY="CHANGE_ME_64_hex_chars"
