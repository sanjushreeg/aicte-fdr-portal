# AICTE FDR Management Portal - Environment Configuration

# SQLite database file for local development
DATABASE_URL="file:./dev.db"

# WARNING: CRITICAL SECURITY CONFIGURATION
# In production, replace NEXTAUTH_SECRET with a cryptographically secure random 32+ character string.
# Example: openssl rand -base64 32
NEXTAUTH_SECRET="aicte_nextauth_jwt_super_secret_key_12345"
NEXTAUTH_URL="http://localhost:3000"

# WARNING: CRITICAL AES-256-GCM DATA ENCRYPTION KEY
# The encryption key used to encrypt sensitive deposit fields and files at rest.
# Must be kept strictly confidential. Do NOT commit the production key to git.
ENCRYPTION_KEY="aicte_portal_default_secret_key_32_bytes!!"
